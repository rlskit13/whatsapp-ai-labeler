# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any OpenRouter-supported model id. Default is a cheap general-purpose model.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional, used by OpenRouter for its leaderboard/analytics headers
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_SITE_NAME=WhatsApp AI Labeler

# Folder where the Chrome persistent profile (WhatsApp Web login/session) is stored.
# Treat this folder like a password - anyone with it can access your WhatsApp session.
WHATSAPP_USER_DATA_DIR=./.wwebjs_session

# How often (ms) the watch loop re-scans for new/unread messages
WATCH_POLL_INTERVAL_MS=4000

# When true, classification still runs and is logged, but no WhatsApp UI label is applied.
# Useful for safely testing selectors/prompt before touching your real chats.
DRY_RUN=false
